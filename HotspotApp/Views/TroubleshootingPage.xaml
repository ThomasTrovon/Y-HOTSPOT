<views:ViewModelPage
  x:Class="HotspotApp.Views.TroubleshootingPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:HotspotApp.Controls"
  xmlns:models="using:HotspotApp.Models"
  xmlns:views="using:HotspotApp.Views"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
>
  <Grid Padding="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageHeader
      x:Uid="TroubleshootingPage_Header"
      Glyph="&#xE90F;"
      IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
    />

    <ScrollViewer Grid.Row="1">
      <ItemsControl
        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
        HorizontalAlignment="Stretch"
      >
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:TroubleshootingItem">
            <Expander
              Header="{x:Bind Title}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
            >
              <Grid Padding="0,8,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                <Button
                  Grid.Column="1"
                  Content="{x:Bind FixLabel}"
                  Command="{x:Bind FixCommand}"
                  HorizontalAlignment="Right"
                />
              </Grid>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</views:ViewModelPage>
