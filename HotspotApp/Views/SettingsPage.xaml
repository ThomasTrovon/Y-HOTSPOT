<views:ViewModelPage
  x:Class="HotspotApp.Views.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:HotspotApp.Controls"
  xmlns:views="using:HotspotApp.Views"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <controls:PageHeader
      x:Uid="SettingsPage_Header"
      Glyph="&#xE713;"
      IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
      Margin="24"
    />

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="24,0,24,24" Spacing="20" HorizontalAlignment="Stretch">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
            x:Uid="SettingsPage_SsidHeader"
            Text="{x:Bind ViewModel.Ssid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          />
          <Button
            x:Uid="SettingsPage_CopySsid"
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Command="{x:Bind ViewModel.CopySsidCommand}"
          />
        </Grid>

        <ComboBox
          x:Uid="SettingsPage_SecurityHeader"
          HorizontalAlignment="Stretch"
          ItemsSource="{x:Bind ViewModel.AuthenticationOptions}"
          SelectedItem="{x:Bind ViewModel.SelectedAuthentication, Mode=TwoWay}"
          DisplayMemberPath="Label"
        />

        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock x:Uid="SettingsPage_PasswordHeader" Margin="0,0,0,8" Grid.ColumnSpan="2" />

          <TextBox
            x:Uid="SettingsPage_PasswordBox"
            Grid.Row="1"
            Text="{x:Bind ViewModel.Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          />
          <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
          >
            <Button
              x:Uid="SettingsPage_PasswordGenerate"
              Command="{x:Bind ViewModel.GeneratePasswordCommand}"
            />
            <Button
              x:Uid="SettingsPage_CopyPassword"
              Command="{x:Bind ViewModel.CopyPasswordCommand}"
            />
          </StackPanel>
        </Grid>

        <ComboBox
          x:Uid="SettingsPage_BandHeader"
          HorizontalAlignment="Stretch"
          ItemsSource="{x:Bind ViewModel.BandOptions}"
          SelectedItem="{x:Bind ViewModel.SelectedBand, Mode=TwoWay}"
          DisplayMemberPath="Label"
        />

        <NumberBox
          x:Uid="SettingsPage_DeviceLimitHeader"
          HorizontalAlignment="Stretch"
          Minimum="1"
          Maximum="32"
          SmallChange="1"
          LargeChange="2"
          SpinButtonPlacementMode="Inline"
          Value="{x:Bind ViewModel.MaxClientCount, Mode=TwoWay}"
        />

        <Border
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          CornerRadius="4"
          Padding="12"
        >
          <StackPanel Spacing="15">
            <CheckBox
              x:Uid="SettingsPage_EnableService"
              IsChecked="{x:Bind ViewModel.EnableService, Mode=TwoWay}"
              Margin="0,-4,0,0"
            />
            <TextBlock
              x:Uid="SettingsPage_EnableServiceDescription"
              Style="{ThemeResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Margin="0,-16,0,0"
            />
            <CheckBox
              x:Uid="SettingsPage_DisableAutoConfig"
              IsChecked="{x:Bind ViewModel.DisableAutoConfig, Mode=TwoWay}"
            />
            <TextBlock
              x:Uid="SettingsPage_DisableAutoConfigDescription"
              Style="{ThemeResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Margin="0,-16,0,0"
            />
            <CheckBox
              x:Uid="SettingsPage_ForceLanFallback"
              IsChecked="{x:Bind ViewModel.ForceLanFallback, Mode=TwoWay}"
            />
            <TextBlock
              x:Uid="SettingsPage_ForceLanFallbackDescription"
              Style="{ThemeResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Margin="0,-16,0,0"
            />
            <ComboBox
              x:Uid="SettingsPage_DisconnectModeHeader"
              HorizontalAlignment="Stretch"
              ItemsSource="{x:Bind ViewModel.DisconnectOptions}"
              SelectedItem="{x:Bind ViewModel.SelectedDisconnectMode, Mode=TwoWay}"
              DisplayMemberPath="Label"
            />
            <TextBlock
              x:Uid="SettingsPage_DisconnectModeDescription"
              Style="{ThemeResource CaptionTextBlockStyle}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              Margin="0,-10,0,0"
            />
          </StackPanel>
        </Border>

        <ComboBox
          x:Uid="SettingsPage_LogDetailHeader"
          HorizontalAlignment="Stretch"
          ItemsSource="{x:Bind ViewModel.LogLevelOptions}"
          SelectedItem="{x:Bind ViewModel.SelectedLogLevel, Mode=TwoWay}"
          DisplayMemberPath="Label"
        />
      </StackPanel>
    </ScrollViewer>

    <Border
      Grid.Row="2"
      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
      BorderThickness="0,1,0,0"
      Padding="24,16"
    >
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button x:Uid="SettingsPage_ResetApp" Command="{x:Bind ViewModel.ResetCommand}" />
        <Button x:Uid="SettingsPage_ViewLogs" Command="{x:Bind ViewModel.OpenConfigCommand}" />
        <Button
          x:Uid="SettingsPage_ShowQr"
          Command="{x:Bind ViewModel.ShowQrCodeCommand}"
          IsEnabled="{x:Bind ViewModel.EnableService, Mode=OneWay}"
        />
        <Button
          x:Uid="SettingsPage_Save"
          Command="{x:Bind ViewModel.SaveCommand}"
          Style="{ThemeResource AccentButtonStyle}"
        />
      </StackPanel>
    </Border>
  </Grid>
</views:ViewModelPage>
